# Корень монорепо: переменные для документации. Рабочие значения — в backend/.env и frontend/.env.local

# === Backend (см. backend/.env.example) ===
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connexy?schema=public
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# === AUTH ===
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_EXPIRES_IN=7d

# === SECURITY (опционально; без ключа шифрование сообщений отключено) ===
PEPPER_SECRET=
MESSAGE_ENCRYPTION_KEY=
BCRYPT_ROUNDS=12

# === 2FA ===
TOTP_ISSUER=Connexy
TOTP_WINDOW=1

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_MESSAGE=200

# === INVITE ===
INVITE_TOKEN_EXPIRES_HOURS=48

FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:3001
