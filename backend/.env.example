NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Postgres (локально или Render/Neon; для облака часто нужен ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connexy?schema=public

# JWT: секрет должен быть сильным и уникальным.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_128_CHAR_HEX

# Access token — короткий (по умолчанию 15m)
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token — долгий (30 дней, пользователь не выходит месяц)
JWT_REFRESH_EXPIRES_DAYS=30

# Временный JWT для шага 2FA после логина (отдельный секрет)
JWT_TEMP_SECRET=REPLACE_WITH_32_BYTE_HEX
JWT_TEMP_EXPIRES=5m

# Pepper для паролей (опционально; пусто = только bcrypt, как раньше)
PEPPER_SECRET=
BCRYPT_ROUNDS=12

# AES-256-GCM для поля текста сообщений (64 hex символа = 32 байта). Пусто = без шифрования
# Ротация: старый ключ → MESSAGE_ENCRYPTION_KEY_V1, новый → MESSAGE_ENCRYPTION_KEY
MESSAGE_ENCRYPTION_KEY_V1=
MESSAGE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# 2FA
TOTP_ISSUER=Connexy
TOTP_WINDOW=1

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=400
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_MESSAGE=200

INVITE_TOKEN_EXPIRES_HOURS=48

# Токен для регистрации первого пользователя (owner/admin)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# После регистрации первого пользователя — удалить или оставить пустым
BOOTSTRAP_INVITE_TOKEN=

FRONTEND_URL=http://localhost:3000

# Web Push (VAPID) — сгенерировать: cd backend && node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey); console.log('VAPID_PRIVATE_KEY='+k.privateKey)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@connexy.app

# Stripe — взять из dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ID из Stripe Dashboard → Products
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Chat <your-email@example.com>"

# Cloudinary — хранилище файлов (вместо диска Render)
# Зарегистрироваться: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
