# URL бэкенда (локально — порт 3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Web Push / PWA в dev: зарегистрировать service worker (иначе в development SW снимается).
# http://localhost считается «безопасным контекстом» — HTTPS для локалки не нужен.
# Возможны глюки HMR; для стабильной проверки лучше: npm run build && npm start.
NEXT_PUBLIC_ENABLE_SW_IN_DEV=

# --- WebRTC / TURN (опционально; без TURN часть звонков за симметричным NAT не установится) ---
# Вариант A — Metered.ca: https://www.metered.ca/tools/openrelay/ → Open Relay Project → скопировать URLs + username + credential
# NEXT_PUBLIC_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443?transport=tcp,turns:openrelay.metered.ca:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=...
# NEXT_PUBLIC_TURN_CREDENTIAL=...
#
# Вариант B — свой coturn: задать те же три переменные (URLs через запятую), логин/пароль из turnserver.conf (use-auth-secret + static-auth-secret → time-limited credentials, либо user=...).
#
# Вариант C — полный список ICE в JSON (добавляется к STUN Google выше): см. RTCIceServer в MDN
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=[{"urls":["turn:your.host:3478"],"username":"u","credential":"p"}]
